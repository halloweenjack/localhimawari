    dataCtrl: {
      pcTmpl: {
        create: function (tile, i) {
          var $ctrlBox = $(".pc #data_select_box");
          var $ctrlUI;
          $ctrlUI = this.parentNode(tile, i);
          $ctrlBox.append($ctrlUI);
        },
        parentNode: function (tile, i) {
          //console.log("dataCtrl.pcTmpl.parentNode tile", tile);
          var sortClass = "none";
          var sortableClass = "";
          if (tile.sortable && tile.sortable == true) {
            sortClass = "drag";
            sortableClass = "sortable";
          }
          var updateClass = "none";
          if (tile.update && tile.update == true) {
            updateClass = "time";
          }
          var slider = "";
          var sliderClass = "no-range";
          if (tile.transparent && tile.transparent == true) {
            slider = "<input type='range' id='r" + i + "' min='1' max='10'step='1' />";
            sliderClass = "";
          }
          var ctrlHtml = '<div class="data ' + sortableClass + '"><div class="tnBox switch"><div class="menu-box ctrl_disabled"><div class="col-left"><dl><dt class="' +
                             sortClass + '"></dt><dt class="' + updateClass +
                             '"></dt></dl></div><div class="col-right"><p class="turnBoxButton dctrl_name off"></p></div></div><div class="menu-box ctrl_enabled"><div class="col-left"><dl><dt class="' +
                             sortClass + '"></dt><dt class="' + updateClass + '"></dt></dl></div><div class="col-right ' + sliderClass + '">' +
                             slider + '<p class="turnBoxButton turnBoxButtonPrev dctrl_name"></p></div></div></div></div>';
          var $ctrl = $(ctrlHtml);
          $ctrl.attr("id", tile.name);
          $ctrl.find(".dctrl_name").text(tile.label).attr("data-name", tile.name);
          if (tile.style && tile.style.opacity) {
            $ctrl.find("input[type='range']").val(parseInt(tile.style.opacity * 10));
          }
          $ctrl.find(".ctrl_enabled").addClass("not_exclude");
          if (tile.children) {
            $ctrl.addClass("parent");
            $ctrl.find(".ctrl_enabled .col-right").addClass("col-right-move");
            $ctrl.find(".ctrl_enabled .col-right").append("<span class='move' />");
            var childrenNode;
            if (tile.children.getNode != undefined) {
              childrenNode = tile.children.getNode();
            }
            var $submenu = this.childrenNode(childrenNode, i);
            $ctrl.find(".ctrl_enabled").append($submenu);
          }
          return $ctrl;
        },
        childrenNode: function (children, i) {
          var $childrenNode = $("<div class='sub-range' />");
          var cCnt = children.length;
          var childHtml = "";

          for (var j = 0; j < cCnt; j++) {
            var index = j + i * 100;
            var slider = "";
            if (children[j].transparent && children[j].transparent == true) {
              slider = "<input type='range' id='r" + index + "' min='1' max='10'step='1' value='" + parseInt(children[j].style.opacity * 10) + "' />";
            }
            $child = $(
              "<div class='sub_data data'><div class='tnBox switch'><div class='menu-box ctrl_disabled'><p class='turnBoxButton off' /></div><div class='menu-box ctrl_enabled'>" +
                slider +
                "<p class='turnBoxButton turnBoxButtonPrev' /></div></div></div>"
            );
            $child.find("p").text(children[j].label).attr("data-name", children[j].name);
            $child.attr("id", children[j].name);
            $childrenNode.append($child);

            if (children[j].children) {
              var $childChildrenNode = this.childrenNode(children[j].children, index);
              $childrenNode.append("<span class='move' />");
              $childrenNode.append($childChildrenNode);
            }
          }
          return $childrenNode;
        },
        //*
        format: function () {
          //*
          // データ選択ボタンクリック時の処理
          //console.log("debuglog .tnBox ");
          $(".tnBox").css({
            //width: 220,
            height: 40,
            easing: "ease-in-out",
            duration: 400,
          });
          var $tnBox = $(".tnBox");
          var blen = $tnBox.length;

          for (var i = 0; i < blen; i++) {
            var $box = $tnBox.eq(i).parent();
