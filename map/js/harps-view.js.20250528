      url1weekago += "&variable=dwn.sw.flx.sfc&type=msm";

      var day3daysago = new Date($.harpsModel.time.now);
      day3daysago.setDate(day3daysago.getDate() - 3);
      var year3daysago = day3daysago.getFullYear();
