  };

  /**
   * メニューボタンの初期化
   */
  var _initMenuBtn = function () {
    // メニューの表示切替
    if ($.harpsModel.util.isMobileWindow() == true) {
      _initMobileMenu();
    } else {
      _initPCMenu();
    }

    $("#submenu_area").on({
      toggle_submenu: function () {
        $(this).toggleClass("visible");
        $("header .title .submenu_button").toggleClass("visible");
      },
      open_submenu: function () {
        $(this).addClass("visible");
        $("header .title .submenu_button").addClass("visible");
      },
      close_submenu: function () {
        $(this).removeClass("visible");
        $("header .title .submenu_button").removeClass("visible");
      },
    });
    $("header .title .submenu_button").on("click", function () {
      $(this).parents("header").find("#submenu_area").trigger("toggle_submenu");
    });
  };
  var _initPCMenu = function () {
    $("header.mobile").remove();
    $("header.pc").css("display", "block");

    $(".side-menu").on({
      open_quick: function () {
        $("header .title .menu_button").toggleClass("open", true);
        $(this).toggleClass("open", true);
      },
      close_quick: function () {
        $(".sub-range").trigger("close_sub");
        $("header .title .menu_button").toggleClass("open", false);
        $(this).toggleClass("open", false);
      },
      open: function () {
        $(this).animate({ left: "0px" }, "swing");
        $("header .title .menu_button").toggleClass("open", true);
        $(this).toggleClass("open", true);
      },
      close: function () {
        $(this).animate(
          { left: "-=" + $(this).width() + "px" },
          200,
          "swing",
          function () {
            $(".sub-range").trigger("close_sub");
            $("header .title .menu_button").toggleClass("open", false);
            $(this).toggleClass("open", false);
          }
        );
      },
    });

    $("header .title .menu_button").on("click", function () {
      $(".side-menu").trigger("open");
      $.harpsModel.viewurl.save();
    });
    $("#close-btn").on("click", function () {
      $(".side-menu").trigger("close");
      setTimeout(function () {
        $.harpsModel.viewurl.save();
      }, 250);
    });

    // 初期表示時にメニューを開いた状態にする
    $(".pc .side-menu").trigger("open_quick");
  };
  var _initMobileMenu = function () {
    $("header.pc").remove();
    $("header.mobile").css("display", "block");
    //$("#time_controller").addClass("mobile");
    //$("#autorun_panel").addClass("mobile");

    $("#mobile-menu").on({
      open_quick: function () {
        $("header.mobile .title .left").addClass("open");
        $(this).addClass("open");
        $("#submenu_area").trigger("close_submenu");
        $("#slider").trigger("open");
      },
      close_quick: function () {
        $("header.mobile .title .left").removeClass("open");
        $(this).removeClass("open");
        $("#slider").trigger("close");
      },
      open: function () {
        $("header.mobile .title .left").addClass("open");
        $(this).addClass("open");
        $("#submenu_area").trigger("close_submenu");
        $("#slider").trigger("open");
      },
      close: function () {
        $("header.mobile .title .left").removeClass("open");
        $(this).removeClass("open");
        $("#slider").trigger("close");
      },
    });
    $("header.mobile .title .left").on({
      click: function () {
        if ($(this).hasClass("open")) {
          $("#mobile-menu").trigger("close");
        } else {
          $("#mobile-menu").trigger("open");
        }
        $.harpsModel.viewurl.save();
      },
    });
    // モバイルでの時刻スライダー
    _initMobileSlider();
  };

  // スマホ用スライダーの初期化
  var _initMobileSlider = function () {
    var min = 0;
    var max = 1439; // 1日のステップ数, 60分x24時間
    var sTimeVal = _getDayMinute($.harpsModel.time.now);
    var $slider = $(
      '<section id="slider"><div id="time_display"><p>00:00</p><p>12:00</p><p>24:00</p></div><div id="time_slider"><input type="range" min="' +
        min +
        '" max="' +
        max +
        '" value="' +
        sTimeVal +
        '" step="1" data-rangeslider><output></output></div></section>'
    );
    $slider.appendTo("body");
    $("#slider input[type=range]").rangeslider({
      polyfill: false,
    });

    var touchY = null;
    var sTime = null;
    $("#time_display, #time_slider").on({
      touchstart: function (e) {
        sTime = _getNewTime(e);
        // スライダーの表示を更新
        $("#slider input").val(sTime.timeVal).change();
        // 時刻表示を更新
        $.harpsModel.time.setDate(sTime.date);
        // スライダーを下スワイプで閉じるようの値を取得
        touchY = e.originalEvent.touches[0].pageY;
        setTimeout(function () {
          touchY = null;
        }, 300);
      },
      touchmove: function (e) {
        var nTime = _getNewTime(e);
        // スライダーの表示を更新
        $("#slider input").val(nTime.timeVal).change();
        // 時刻表示を更新
        $.harpsModel.time.setDate(nTime.date);
      },
      touchend: function (e) {
        $("header .date .reload_button").trigger("stop_autoupdate");
        var endTouchY = e.originalEvent.changedTouches[0].pageY;
        if (touchY != null && endTouchY - touchY > 20) {
          // 下スワイプの場合は時刻表示をsTimeに戻してスライダーを閉じる
          $("#slider").trigger("close");
          $("#slider input").val(sTime.timeVal).change();
          $.harpsModel.time.setDate(sTime.date);
        } else {
          // タイル画像のデータのアップデート
          $.harpsModel.overlayMaps.updateImg();
          // 画像以外のデータのアップデート
          $.harpsModel.tiles.updateOther();
        }
      },
    });
    $("#time_slider").on({
      update: function () {
        var cTimeVal = _getDayMinute($.harpsModel.time.now);
        $("#slider input").val(cTimeVal).change();
      },
    });

    // スライダーを表示するためのスワイプイベント
    var swipe = false;
    var startY = null;
    $("#slider").on({
      "touchstart.open_slider": function (e) {
        swipe = true;
        startY = e.originalEvent.touches[0].pageY;
      },
      open: function () {
        $("#slider").addClass("open");
      },
      close: function () {
        $("#slider").addClass("close");
        setTimeout(function () {
          $("#slider").removeClass("open");
          $("#slider").removeClass("close");
        }, 300);
      },
    });
    $("body").on({
      "touchend.open_slider": function (e) {
        if (swipe == true) {
          var endY = e.originalEvent.changedTouches[0].pageY;
          if (startY - endY > 10) {
            $("#slider").trigger("open");
          }
          swipe = false;
        }
        //e.stopPropergation();
      },
    });
    // コメントアウト 2019.02.20 dol-add
    // google.maps.event.addListener($.harpsModel.map, "mousedown", function(e){
    //   $("#slider").trigger("close");
    // });
    // コメントアウト 2019.02.20 dol-end
    // 2019.02.21 dol-add
    $.harpsModel.map.on("mousedown", function () {
      $("#slider").trigger("close");
    });
    // 2019.02.21 dol-end
  };

  // スライダー上の現在時刻,スライダーの設定値を取得
  var _getNewTime = function (e) {
    // スライダーの設定値の取得
    var sliderLeft = $("#slider input").offset().left;
    var sliderWidth = $("#time_slider .rangeslider").width();
    var offsetX = Math.floor(e.originalEvent.touches[0].screenX - sliderLeft);
    if (offsetX < 0) offsetX = 0;
    if (offsetX > sliderWidth) offsetX = sliderWidth;
    var timeVal = Math.floor(
      (offsetX / sliderWidth) * parseInt($("#slider input").attr("max"))
    );

    // 現在時刻の取得
    var objStart = new Date($.harpsModel.util.date2str($.harpsModel.time.now, "%Y/%m/%d 00:00:00"));
    var objDate = new Date(objStart.getTime() + timeVal * 60 * 1000);
    var objTime = objDate.getTime();
    var latestTime = $.harpsModel.time.end.getTime();
    var startTime = $.harpsModel.time.start.getTime();
    // start, endの範囲外の場合はtimeValを再取得する
    if (objTime > latestTime) {
      objDate = new Date(latestTime);
      var objToday = new Date(
        $.harpsModel.util.date2str(objDate, "%Y/%m/%d 00:00:00")
      );
      timeVal = (objDate.getTime() - objToday.getTime()) / 60000;
    }
    if (objTime < startTime) {
      objDate = new Date(startTime);
      var objToday = new Date(
        $.harpsModel.util.date2str(objDate, "%Y/%m/%d 00:00:00")
      );
      timeVal = (objDate.getTime() - objToday.getTime()) / 60000;
    }
    return { date: objDate, timeVal: timeVal };
  };

  // 指定した日時の当日からの通し分を取得
  var _getDayMinute = function (time) {
    var hour = $.harpsModel.util.date2str(time, "%H");
    var min = $.harpsModel.util.date2str(time, "%M");
    return parseInt(hour) * 60 + parseInt(min);
  };

  /**
   * サブメニューの初期化
   */
  var _initSubMenu = function () {
    _initViewURL();
    if ($.harpsEnv.eventViewer && $.harpsEnv.eventViewer == true) {
      setTimeout(function () {
        _initEventViewer();
      }, 10);
    }

    /******************************************************************************/
    /* submenu_area autorun_button.click                                          */
    /******************************************************************************/
    $("#submenu_area .autorun_button").on("click", function(pEvent, pExtra) {
        console.log("autorun_button start 1");
    });
  };
  /**
   * ViewURL表示の初期化
   */
  var _initViewURL = function () {
    // URL表示の自動選択
    var _fncSelectText = function (e) {
      var text = $("#viewurl_dialog .textarea")[0];
      text.focus();
      text.setSelectionRange(0, text.value.length);
    };
    if ($.harpsModel.util.isMobileAgent() == false) {
      $("#viewurl_dialog .textarea").on({
        click: _fncSelectText,
      });
    } else {
      $("#viewurl_dialog .textarea").on({
        touchstart: _fncSelectText,
      });
    }

    $("#submenu_area .view_url_button").on("click", function () {
      var strViewUrl = $.harpsModel.viewurl.get();
      $("#viewurl_dialog").children(".textarea").text(strViewUrl);
      $("#viewurl_dialog").dialog({
        title: VIEWURL_TITLE,
        width: "70%",
        height: 200,
        dialogClass: "viewurl_dialog",
        modal: true,
        closeText: "",
        position: { my: "center top+150", at: "center top", of: window },
        show: 200,
        hide: 200,
        draggable: false,
        open: function () {
          $("#submenu_area").trigger("close_submenu");
          _fncSelectText();
          // closeボタンの追加
          if ($(this).prev().children(".dialog_close").length == 0) {
            $(".ui-dialog-titlebar-close").hide();
            var $close = $('<div class="dialog_close" />');
            var $dialog = $(this);
            $close.on("click", function () {
              $dialog.dialog("close");
            });
            $(this).prev().append($close);
          }
        },
        resizable: false,
      });
    });
  };

  // イベント表示の初期化
  var _initEventViewer = function () {
    $("#submenu_area .event_button").harpsEventViewer({
      jsonPath: "json/event.js",
      appendTo: "header",
      open: function () {
        $.harpsModel.storage.set("eventView", true);
        $("#submenu_area").trigger("close_submenu");
      },
      close: function () {
        $.harpsModel.storage.set("eventView", false);
        $("#submenu_area").trigger("close_submenu");
      },
    });
    if ($.harpsModel.storage.get("eventView") != false) {
      $("#submenu_area .event_button").trigger("create.harpsEventViewer");
      $(window).trigger("resize.harpsEventViewer");
    }
  };

  /**
   * ズームボタンの初期化
   */
  var _initZoomBtn = function () {
    // ズームイン/アウトボタンクリック時の処理
    $(".zoom_in").on("click", function () {
      if (!$(this).hasClass("disabled")) {
        $.harpsModel.zoom.zoomIn();
      }
    });
    $(".zoom_out").on("click", function () {
      if (!$(this).hasClass("disabled")) {
        $.harpsModel.zoom.zoomOut();
      }
    });

    // ズームイベント発生時にズームイン/アウトボタンのdisabledを切り替える
    $zoomBtn = $("#zoom_button");
    $zoomBtn.on({
      update: function () {
        var zoom = $.harpsModel.map.getZoom();
        if (zoom >= $.harpsEnv.mapOpt.maxZoom) {
          $(".zoom_in").addClass("disabled");
        } else {
          $(".zoom_in").removeClass("disabled");
        }
        if (zoom <= $.harpsEnv.mapOpt.minZoom) {
          $(".zoom_out").addClass("disabled");
        } else {
          $(".zoom_out").removeClass("disabled");
        }
        // zoom_min - zoom_maxの間にないデータは選択不可にする
        $.harpsModel.tiles.chkZoomLevel();
      },
      lock: function () {
        $(".zoom_in").addClass("disabled");
        $(".zoom_out").addClass("disabled");
      },
      unlock: function () {
        $(".zoom_in").removeClass("disabled");
        $(".zoom_out").removeClass("disabled");
      },
    });
    // コメントアウト 2019.02.20 dol-add
    // google.maps.event.addListener($.harpsModel.map, "zoom_changed", function(){
    //   $zoomBtn.trigger("update");
    //   $("#data_select_box .data").each(function(){
    //     var tileSetting = $.harpsModel.tiles.get($(this).attr("id"));
    //     // センターアイコンのサイズ変更（レーダデータ向け）
    //     $.harpsModel.overlayMaps.circles.zoomChange(tileSetting);
    //   });
    // });
    // コメントアウト 2019.02.20 dol-end
    // 2019.02.21 dol-add
    $.harpsModel.map.on("zoomend", function () {
      $zoomBtn.trigger("update");
      $("#data_select_box .data").each(function () {
        var tileSetting = $.harpsModel.tiles.get($(this).attr("id"));
        // センターアイコンのサイズ変更（レーダデータ向け）
        $.harpsModel.overlayMaps.circles.zoomChange(tileSetting);
      });
    });
    // 2019.02.21 dol-end
  };

  /**
   * 初期表示ボタンの初期化
   */
  var _initDefaultBtn = function () {
    $(".center_button").on({
      click: function () {
        $.harpsModel.position.default();
        $("#submenu_area").trigger("close_submenu");
      },
      lock: function () {
        $(this).addClass("disabled");
      },
      unlock: function () {
        $(this).removeClass("disabled");
      },
    });
  };

  /**
   * 現在地表示ボタンの初期化
   */
  var _initGpsBtn = function () {
    var success = function (pos) {
      $(".gps_button").removeClass("gps_loading");
      $(".gps_button").addClass("gps_on");

      if ($.harpsModel.currentPos != null) {
        $.harpsModel.currentPos.setMap(null);
      }

      const latLng = new mapboxgl.LngLat(
        pos.coords.longitude,
        pos.coords.latitude
      );
      const marker = new mapboxgl.Marker()
        .setLngLat(latLng)
        .addTo($.harpsModel.map);
      $.harpsModel.currentPos = marker;
      $.harpsModel.map.panTo(latLng);
    };
    var fail = function (error) {
      alert(GPS_ERR2);
      $(".gps_button").removeClass("gps_loading");
    };

    $(".gps_button").on({
      click: function () {
        $("#submenu_area").trigger("close_submenu");
        if ($(this).hasClass("gps_on")) {
          // gps_onの状態かつマーカーが画面内でクリックした場合はマーカーを消す
          // マーカーが画面外にある場合は現在地を取得し直す
          if ($.harpsModel.currentPos != null) {
            if (
              $.harpsModel.map
                .getBounds()
                .contains($.harpsModel.currentPos.position)
            ) {
              $(this).removeClass("gps_on");
              $.harpsModel.currentPos.setMap(null);
              return;
            }
          }
        }
        if (!$(this).hasClass("gps_loading")) {
          $(this).removeClass("gps_on");
          if (navigator.geolocation) {
            $(this).addClass("gps_loading");
            navigator.geolocation.getCurrentPosition(success, fail);
          } else {
            alert(GPS_ERR1);
            $(this).removeClass("gps_loading");
          }
        } else {
          // gps_loading状態の時は何もしない
          // DO NOTHING
        }
      },
      lock: function () {
        $(this).addClass("disabled");
      },
      unlock: function () {
        $(this).removeClass("disabled");
      },
    });
  };

  var _initDataControl = function () {
    // データ選択ボタンのイベント追加
    var _execByType = function (dname, tileFnc, markerFnc, defaultFnc) {
      var tileSetting = $.harpsModel.tiles.get(dname);
      switch (tileSetting.display) {
        case "tile":
          tileFnc(dname);
          break;
        case "marker":
          markerFnc(dname);
          break;
        default:
          defaultFnc(dname);
          break;
      }
      $.harpsModel.viewurl.save();
    };
    // モバイルメニューの選択
    $("#mobile-menu #data_select_box .data").on({
      click: function () {
        var dname = $(this).attr("id");
        var tileSetting = $.harpsModel.tiles.get(dname);

        if (!$(this).hasClass("on")) {
          // exclusive設定が存在する場合はexclusive対象データをoffにする
          if (tileSetting.exclusive) {
            var elen = tileSetting.exclusive.length;
            for (var i = 0; i < elen; i++) {
              var $exclusive = $("#data_select_box").find("#" + tileSetting.exclusive[i]);
              if ($exclusive.hasClass("on")) {
                $exclusive.trigger("click");
              }
            }
          }
          _execByType(
            dname,
            $.harpsModel.overlayMaps.add,
            $.harpsModel.marker.add,
            function () {} // DO NOTHING
          );
          $(this).addClass("on");
          $("#data_slider_box .slider[data-name=" + dname + "]").trigger(
            "show"
          );
        } else {
          _execByType(
            dname,
            $.harpsModel.overlayMaps.remove,
            $.harpsModel.marker.remove,
            function () {} // DO NOTHING
          );
          $(this).removeClass("on");
          $("#data_slider_box .slider[data-name=" + dname + "]").trigger(
            "hide"
          );
        }
      },
    });
    $("#data_select_box .data, .sub-range .sub_data").on({
      /* 03.23.2020 uchino */
      open_box: function (e) {
        var box_style = document.getElementById($(this).attr("id"));
        $("#" + $(this).attr("id"))
          .find(".ctrl_enabled")
          .css("display", "flex");
        $("#" + $(this).attr("id"))
          .find(".ctrl_disabled")
          .css("display", "none");
      },
      close_box: function (e) {
        var box_style = document.getElementById($(this).attr("id"));
        $("#" + $(this).attr("id"))
          .find(".ctrl_disabled")
          .css("display", "flex");
        $("#" + $(this).attr("id"))
          .find(".ctrl_enabled")
          .css("display", "none");
      },
      /* 03.23.2020 uchino end */
      select_data: function (e) {
        if (!$(this).find(".ctrl_disabled").hasClass("turnBoxShow")) {
          //03.23.2020 uchino
          // return;
        }
        var dname = $(this).attr("id");
        // 2017.08.04 村永
        // h8jp選択時にh8jpの最新時刻を表示するように、最新時刻取得処理の呼び出し
        // 時刻ステータスがlatestの場合(hasClassでは情報を取れない)
        if ($.harpsModel.time.now.getTime() == $.harpsModel.time.end.getTime()) {
          if (dname == "h8jp") {
            $.harpsModel.time.getLatestH8jp();
            $("header .date .reload_button").trigger("not_latest");
          } else {
            $.harpsModel.time.getLatest();
	  }
          if (dname == "amjp") {
            // 初回表示時は処理しない
            if (init_flag == true) {
              init_flag = false;
            } else {
              // 2018.06.15 村永
              // 日射量のON/OFFで最新or自動更新が解除されるのはやめる
              //$("header .date .reload_button").trigger("not_latest");
            }
          }
        }
        // 2017.08.04 村永-end
        //03.23.2020 uchino
        //$(this).trigger("open_box." + dname);
        $(this).trigger("open_box");

        var tileSetting = $.harpsModel.tiles.get(dname);
        var select;
        if (tileSetting.children) {
          $(this).find(".sub-range").trigger("open_sub");
          select = tileSetting.children.selected;
          var slen = select.length;
          for (var i = 0; i < slen; i++) {
            $("#" + select[i]).trigger("open_box");
          }
        } else {
          select = [dname];
        }
        var slen = select.length;
        for (var i = 0; i < slen; i++) {
          _execByType(select[i], $.harpsModel.overlayMaps.add, $.harpsModel.marker.add, function (){} );
        }
        // サブメニューの選択上限数のチェック
        if ($(this).hasClass(".sub_data")) {
          $(this).parent(".sub-range").trigger("chk_select_max");
        }
        // exclusive設定が存在する場合はexclusive対象データをoffにする
        if (tileSetting.exclusive) {
          var elen = tileSetting.exclusive.length;
          for (var i = 0; i < elen; i++) {
            var $exclusive = $("#data_select_box").find(
              "#" + tileSetting.exclusive[i]
            );
            if ($exclusive.hasClass("on")) {
              $exclusive.trigger("unselect_data");
            }
          }
        }
        // mapColor設定が存在する場合はGoogleMapの色を設定する
        if (tileSetting.mapColor != undefined) {
          if ((tileSetting.mapColor == MCOLOR_WHITE && $("#map_select_box").hasClass("map_color_chg"))
                    || (tileSetting.mapColor == MCOLOR_DARK && !$("#map_select_box").hasClass("map_color_chg"))) {
            $("#map_select_box").find(".map_name.on").trigger("chg_map_style");
          }
        }
        // logo設定が存在する場合はロゴにonクラスを付与する
        $.harpsModel.logo.on(tileSetting);
        e.stopPropagation();

        // 2017.08.15 muranaga
        if (dname == "h8jp" || dname == "h8jp_b13") {
          data_type = "h8jp";
        } else if (dname == "amjp") {
          data_type = "amjp";
        }
        // 2017.08.15 muranaga-end
      },
      unselect_data: function (e) {
        if (!$(this).find(".ctrl_enabled").hasClass("turnBoxShow")) {
          // 03.23.2020 uchino
          // return;
        }
        var dname = $(this).attr("id");
        //03.23.2020 uchino
        //$(this).trigger("close_box." + dname);
        $(this).trigger("close_box");
        var tileSetting = $.harpsModel.tiles.get(dname);
        var select = [];
        if (tileSetting.children) {
          var children = $(this).find(".sub-range").children(".sub_data.on");
          var clen = children.length;
          for (var i = 0; i < clen; i++) {
            children.eq(i).trigger("close_box");
            select.push(children.eq(i).attr("id"));
          }
        } else {
          select.push(dname);
        }
        var slen = select.length;
        for (var i = 0; i < slen; i++) {
          _execByType(
            select[i],
            $.harpsModel.overlayMaps.remove,
            $.harpsModel.marker.remove,
            function () {} // DO NOTHING
          );
        }
        // サブメニューの選択上限数のチェック
        if ($(this).hasClass("sub_data")) {
          $(this).parent(".sub-range").trigger("enable_select");
        }
        // logo設定が存在する場合はロゴのonクラスを削除する
        $.harpsModel.logo.off(tileSetting);
        e.stopPropagation();
      },
    });

    // turnBoxButtonのクリックによるturnBoxのアニメーションはoff
    $(".pc-menu #data_select_box .turnBoxButton").off("click");

    // 連続クリック防止用フラグ
    // turnBoxのアニメーションが終わった後でフラグをfalseにする必要があるため、
    // このフラグはクリック処理の後、setTimeoutで遅延させてからフラグをfalseにする
    var selectClicking = false;
    var unselectClicking = false;
    // データ選択
    $(
      ".pc-menu #data_select_box .ctrl_disabled .col-right, .sub_data .ctrl_disabled"
    ).on({
      click: function (e) {
        if (selectClicking == false && unselectClicking == false) {
          selectClicking = true;
          $(this).closest(".tnBox").parent().trigger("select_data");
          setTimeout(function () {
            selectClicking = false;
          }, DCTRL_CLICK_INTERVAL);
        }
      },
    });

    // 選択解除
    var unselect = false;
    var mouseDown = false;
    var startX = null;
    $(
      ".pc-menu #data_select_box .ctrl_enabled.not_exclude .col-right, .sub_data .ctrl_enabled"
    ).on({
      mousedown: function (e) {
        if (selectClicking == false && unselectClicking == false) {
          unselectClicking = true;
          unselect = true;
          mouseDown = true;
          startX = e.offsetX;
          setTimeout(function () {
            unselectClicking = false;
          }, DCTRL_CLICK_INTERVAL);
        } else {
          unselect = false;
          mouseDown = false;
        }
      },
      mouseup: function (e) {
        mouseDown = false;
        if (unselect == true) {
          unselect = false;
          $(this).closest(".tnBox").parent().trigger("unselect_data");
        }
      },
      mousemove: function (e) {
        if (mouseDown == true) {
          var offsetX = e.originalEvent.offsetX;
          if (Math.abs(startX - offsetX) > DCTRL_SELECT_THRESHOULD) {
            unselect = false;
            var width = $(this).width();
            var opacity = Math.ceil((offsetX / width) * 10);
            if (opacity < 1) opacity = 1;
            if (opacity > 10) opacity = 10;
            if ($(this).find("input[type=range]").val() != opacity) {
              $(this).find("input[type=range]").val(opacity);
              $(this).find("input[type=range]").trigger("ch_opacity");
            }
          }
        }
      },
      mouseleave: function (e) {
        unselect = false;
      },
      // タブレット用
      touchmove: function (e) {
        var offsetX =
          e.originalEvent.touches[0].clientX - $(this).offset().left;
        if (Math.abs(startX - offsetX) > DCTRL_SELECT_THRESHOULD) {
          unselect = false;
          var width = $(this).width();
          var opacity = Math.ceil((offsetX / width) * 10);
          if (opacity < 1) opacity = 1;
          if (opacity > 10) opacity = 10;
          if ($(this).find("input[type=range]").val() != opacity) {
            $(this).find("input[type=range]").val(opacity);
            $(this).find("input[type=range]").trigger("ch_opacity");
          }
        }
      },
    });
    $(document).on("mouseup.map", function () {
      mouseDown = false;
    });

    // サブメニュー表示ボタンクリック時の処理
    $(".move").on({
      mousedown: function (e) {
        mouseDown = false;
        unselect = false;
        if ($(this).parent().next(".sub-range").hasClass("active")) {
          $(this).parent().next(".sub-range").toggleClass("active", false);
        } else {
          $(".sub-range").toggleClass("active", false);
          $(this).parent().next(".sub-range").toggleClass("active");
        }
        e.stopPropagation();
      },
    });

    // サブメニューのイベント登録
    $(".pc-menu .sub-range").on({
      chk_select_max: function () {
        var dname = $(this).parents(".data").attr("id");
        var tileSetting = $.harpsModel.tiles.get(dname);
        if (tileSetting.children.selectMax) {
          if (
            $(this).children(".sub_data.on").length >=
            tileSetting.children.selectMax
          ) {
            $(this).children(":not(.on)").addClass("disabled");
          }
        }
      },
      enable_select: function () {
        var dname = $(this).parents(".data").attr("id");
        var tileSetting = $.harpsModel.tiles.get(dname);
        if (tileSetting.children.selectMax) {
          if (
            $(this).children(".sub_data.on").length <
            tileSetting.children.selectMax
          ) {
            $(this).children(":not(.on)").removeClass("disabled");
          }
        }
      },
    });

    // 画像透過率変更処理
    var opClass = "";
    for (var i = 1; i <= 10; i++) {
      opClass += "opacity_" + i.toString() + " ";
    }
    var _chOpacity = function (val, tileName) {
      if (!$("#map div.tile_image[data-type=" + tileName + "]").eq(0).hasClass("opacity_" + val.toString())) {
        $("#map div.tile_image[data-type=" + tileName + "]").removeClass(opClass);
        $("#map div.tile_image[data-type=" + tileName + "]").addClass("opacity_" + val.toString());
        $("#legend ." + tileName + " .colorbar img").removeClass(opClass);
        $("#legend ." + tileName + " .colorbar img").addClass("opacity_" + val.toString());
        $.harpsModel.tiles.info[tileName]["opacity"] = val;
        //$.harpsModel.tiles.get(tileName).style.opacity = val / 10.0;
      }
      // MIERUNE
      if ($.harpsModel.map.getLayer(tileName)) {
        $.harpsModel.map.setPaintProperty(tileName, "raster-opacity", val / 10.0);
      }
      $.harpsModel.tiles.get(tileName).style.opacity = val / 10.0;
      $.harpsModel.viewurl.save();

      // コメントアウト 2019.02.27 dol-add
      // if(!$("#map div.tile_image[data-type=" + tileName + "]").eq(0).hasClass("opacity_" + val.toString())){
      //   $("#map div.tile_image[data-type=" + tileName + "]").removeClass(opClass);
      //   $("#map div.tile_image[data-type=" + tileName + "]").addClass("opacity_" + val.toString());
      //   $("#legend ." + tileName + " .colorbar img").removeClass(opClass);
      //   $("#legend ." + tileName + " .colorbar img").addClass("opacity_" + val.toString());
      //   $.harpsModel.tiles.info[tileName]["opacity"] = val;
      // }
      // コメントアウト 2019.02.27 dol-add
      // 2019.02.27 dol-add
      /*
    $.each($.harpsModel.overlayGroup._layers, function (e) {
      if ( this.options.name == tileName ) {
        this.setOpacity(val * 0.1);
        var tlen = $.harpsEnv.tiles.length;
        for(var i=0; i<tlen; i++){
          if ( $.harpsEnv.tiles[i].name == tileName ) {
            $.harpsEnv.tiles[i].style.opacity = val * 0.1;
          }
        }
      }
    })
    */
      // 2019.02.27 dol-end
