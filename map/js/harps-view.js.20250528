      url3daysago += "&variable=dwn.sw.flx.sfc&type=msm";

      // 勝様グラフアプリ
      var urlpower = "https://www.hjcg.net/chart/amaterass2/?lat=" + lat + "&lng=" + lng + "&year=" + year + "&month=" + month + "&date=" + date;

      if (infowindow){
        infowindow.close();
      }
      /*
      GeoCoding(lat, lng, function (address) {
