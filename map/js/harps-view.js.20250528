          contentStr += "<br><br><a href=" + urlpower + ' target="_blank">選択地域の太陽光発電出力を表示</a><br></p>';
          //console.log("contentStr = " + contentStr);
          //var popup = L.popup().setLatLng(event.latlng).setContent(contentStr);
          //popup.openOn($.harpsModel.map);
        }
      });
      */
    });

    if ($.harpsModel.util.isMobileWindow()) {
      // モバイルでは地図を動かした場合はメニュー,サブメニューを閉じる
      // コメントアウト 2019.02.20 dol-add
      // google.maps.event.addListener($.harpsModel.map, "mousedown", function(){
      //   $("#mobile-menu").trigger("close");
      //   $("#submenu_area").trigger("close_submenu");
      // });
      // コメントアウト 2019.02.20 dol-end
      // 2019.02.21 dol-add
      $.harpsModel.map.on("mousedown", function () {
        $("#mobile-menu").trigger("close");
        $("#submenu_area").trigger("close_submenu");
      });
      // 2019.02.21 dol-end
    }

    var searchInput = $('#pac-input');
    searchInput.keypress(function(e) {
      console.log("aaaaa");
      if (e.which == 13 && searchInput.val()) {
