$(window).on("load", function () {
  window.isReady = function(){
    console.log("window.isReady");
    return window.document.readyState == "complete" && window.$ && window.$.harpsModel;
  }

  window.getMap = function(){
    return $.harpsModel.map;
  }

  window.setPosition = function(pPosition){
    console.log("harps-view setPosition", pPosition);
    if(!$.harpsModel.map || $.harpsModel.map == undefined) {
      return;
    }
    $.harpsModel.map.setCenter([pPosition.center.lng, pPosition.center.lat]);
    $.harpsModel.map.setZoom(pPosition.zoom);
    $.harpsModel.map.setPitch(pPosition.pitch);
    $.harpsModel.map.setBearing(pPosition.direction);
  }

  window.updateDate = function(pDate){
    /*
     let ct = new Date(Math.floor(pDate.currentTime / 3600000) * 3600000);
     var formatDate = String(ct.getFullYear()).padStart(4, '0') + String(ct.getMonth() + 1).padStart(2, '0') + String(ct.getDate()).padStart(2, '0');
     var formatTime = String(ct.getHours()).padStart(2, '0') + String(ct.getMinutes()).padStart(2, '0');
     console.log("updateDate " + formatDate + " " + formatTime);
     updateLayers(formatDate + formatTime);
    */
    $.harpsModel.time.update(pDate.currentTime);
  }

  window.getLatestDate = function() {
    return $.harpsModel.time.end;
  }

  window.initTimeline = function() {
    //console.log("window.initTimeline", $.harpsModel.time);
    var pDate = {};
    var cDate = $.harpsModel.time.now;
    pDate.currentDate = cDate;
    pDate.startDate   = new Date(cDate.getFullYear(), cDate.getMonth(), cDate.getDate(),   0,  0,  0);
    pDate.endDate     = new Date(cDate.getFullYear(), cDate.getMonth(), cDate.getDate(),  23, 59, 59);
    if(window.parent) {
      console.log("window.initTimeline parent.STARScontroller_setDate", pDate);
      console.log("window.initTimeline parent.STARScontroller_setDate", window.parent.document.readyState);
      /*
      let observer = setInterval(function(){
        if (window.parent.document.readyState == "complete") {
          window.parent.STARScontroller_setDate(pDate);
          crearInterval(observer);
        }
      }, 500);
      */
      window.parent.STARScontroller_setDate(pDate);
    }
  }

  window.getViewURL = function(){
    var url = $.harpsModel.viewurl.getParamURL();
    return "&" + url;
  }

  //window.setViewURL = function(viewUrl){  }

  /**
   * HARPS View
   * @require jquery
   */
  /**
   * 時間の表示フォーマット
   */
  const TIME_FORMAT = "%Y/%m/%d %H:%M:%S";

  /**
   * データ選択解除/透明度変更のマウスカーソルが動いたと判断する閾値(px)
   */
  const DCTRL_SELECT_THRESHOULD = 10;

  /**
   * データ選択ボタンのクリック間隔の閾値(ms) */
  const DCTRL_CLICK_INTERVAL = 500;

  /**
   * 地図色の指定
   */
  const MCOLOR_DARK = 0;
  const MCOLOR_WHITE = 1;

  var init_flag = false;
  var data_type = "amjp";
  var infowindow;

  var getDataType = function () {
    data_type;
  };

  /**
   * Mapの初期化処理
   */
  var _initMap = function () {
    // 一時的に地図種選択を非表示にする
    $('#map_select_box').hide();

    $.harpsModel.map.on("click", function (event) {
        //console.log("harpsModel.map.on click in");
    });

    // アメダス拠点 矩形選択 start
    /*------------- mousedown -------------*/
    $.harpsModel.map.on("mousedown", function (event) {
      if ( ($("#data_select_box #amedas").hasClass("on") && event.originalEvent.button == 2) 
           || ($("#data_select_box #amjp_point").hasClass("on") && event.originalEvent.button == 2) ){

        // マップのドラッグ移動・ロール操作の無効化
        $.harpsModel.map.dragRotate.disable();
        $.harpsModel.map.dragPan.disable();

        $("#map").addClass("mapboxgl-crosshair");

        var isCreatedSelectBox = false;
        var isSelectBox        = false;

        // 矩形選択用の要素生成
        if (!isCreatedSelectBox && !isSelectBox) {
          const selectionBox = document.createElement("div");
          var startX         = event.originalEvent.clientX;
          var startY         = event.originalEvent.clientY;

          isCreatedSelectBox = true;
          isSelectBox        = true;
          selectionBox.id    = "selection-box";

          // マップの要素内に矩形選択の要素追加
          if (selectionBox) {
            $("#selection-box").css({"transform": "translate(" + startX + "px," + startY + "px)", "width": "0px", "height": "0px"});
            $("#map").append(selectionBox);
          } else return;
        }
        /*------------- mousemove -------------*/
        // 矩形選択範囲の変更
        var fncMove = function(event) {
          const initialMouseX = event.clientX;
          const initialMouseY = event.clientY;
          var newWidth, newHeight, newMouseX, newMouseY;
      
          newWidth  = Math.abs(initialMouseX - startX);
          newHeight = Math.abs(initialMouseY - startY);
          newMouseX = initialMouseX >= startX ? startX : initialMouseX;
          newMouseY = initialMouseY >= startY ? startY : initialMouseY;

          if ($("#selection-box")) {
            $("#selection-box").css({"transform": "translate(" + newMouseX + "px," + newMouseY + "px)", "width": newWidth  + "px", "height": newHeight + "px"});
          }
        }
        document.addEventListener("mousemove", fncMove, { passive: false }); 
        /*------------- mouseup -------------*/
        $("#selection-box").on("mouseup", function (event) {
          $("#selection-box").on("contextmenu", function () { return false; });
          document .removeEventListener( "mousemove", fncMove, { passive: false });

          // amCharts用URL生成
          if ($("#data_select_box #amedas").hasClass("on") && event.originalEvent.button == 2) {
            $.harpsModelLocalHIMAWARI.amedas.createSelectAmedasUrl();
          }

          if ($("#data_select_box #amjp_point").hasClass("on") && event.originalEvent.button == 2) {
            $.harpsModelLocalHIMAWARI.amjpPoint.createSelectAmaterassUrl();
          }

          $("#map").removeClass("mapboxgl-crosshair");
          // マップのドラッグ移動・ロール操作の有効化
          $.harpsModel.map.dragPan.enable();
          $.harpsModel.map.dragRotate.enable();
        });
      }
    });
    // アメダス拠点 矩形選択 end
    $.harpsModel.map.on("moveend", function () {
        console.log("moveend");
        $.harpsModel.tiles.chkLatLngTiles();
        console.log("moveend - chkLatLng");
        $.harpsModel.viewurl.save();
        console.log("moveend - viewurl");
    });

    // 自動実行時は停止させる
    $.harpsModel.map.on("mousedown", function () {
	//$.harpsModel.autoRun.stop();

        $("#submenu_area").trigger("close_submenu");
        $("body").removeClass("autorun");
        $('#play_box').removeClass('play');
        $('#button_play').removeClass('play');
        $("body").removeClass("running");
    });

    // MIERUNE : TODO
    $.harpsModel.map.on("bounds_changed", function () {
      console.log("MIERUNE TODO: map on bounds_changed");
      $.harpsModel.tiles.chkLatLngTiles();
      $.harpsModel.viewurl.save();
    });

    $.harpsModel.map.on("contextmenu", function (event) {
      //if(infowindow) infowindow.close();

      lat = event.lngLat.lat;
      lng = event.lngLat.lng;
      console.log("contextmenu lat = " + lat + "  lng = " + lng);

