  // 初期化処理
  //$(window).on("load", function(){//})
  console.log("gisapp init");
  setTimeout(function _loop() {
    if(typeof $.harpsModel.init === undefined) {
      setTimeout(_loop, 500);
    } else {
      $.harpsModel.init();
      $.harpsModel.map.on("style.load", function () {
        $.harpsView.init();
      });

  if ($.harpsModel.viewurl.params.exCo && $.harpsModel.viewurl.params.exCo == 'himawari') {
    setTimeout(function(){
      var rc = window.confirm("ひまわりWebから表示されました。このまま表示しますか。");
      if (rc === false) {
        open('about:blank', '_self').close();
      }
    }, 4000);
  }

    }
  }, 500); 

