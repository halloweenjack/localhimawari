                },
                slide: function (e, ui) {
                  $(this).parents(".slider").trigger("transparent", ui.value);
                },
              });
          });
          */
        },
      },
      sort: function (dlist) {
        $.each(dlist, function () {
          var $item = $("#data_select_box #" + this + ".data");
          var sortItem;
          if ($item.hasClass("sub_data")) {
            sortItem = $item.parents(".parent");
          } else {
            sortItem = $item;
          }
          $("#data_select_box").append(sortItem);
        });
      },
      // 2017.08.15 muranaga
      getDataType: function () {
        return data_type;
      },
    },
  };

