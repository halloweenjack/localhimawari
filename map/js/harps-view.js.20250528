    );
    // PC,tablet用タイル画像透明度変更処理
    $(".pc-menu #data_select_box").on(
      {
        ch_opacity: function () {
          var tileName = $(this).next(".turnBoxButton").attr("data-name");
          if ($(this).parent().next(".sub-range").length != 0) {
            var $children = $(this)
              .parent()
              .next(".sub-range")
              .children(".sub_data");
            var cCnt = $children.length;
            var val = $(this).val();
            for (var i = 0; i < $children.length; i++) {
              var $child = $children.eq(i);
              _chOpacity(val, $child.attr("id"));
            }
          } else {
            _chOpacity($(this).val(), tileName);
          }
        },
      },
      ".data input[type='range']"
    );

