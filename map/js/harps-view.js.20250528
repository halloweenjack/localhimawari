          // サブメニューの表示/非表示切替処理
          $(".sub-range").on({
            open_sub: function () {
              $(".sub-range").toggleClass("active", false);
              $(this).toggleClass("active", true);
            },
            close_sub: function () {
              $(this).toggleClass("active", false);
