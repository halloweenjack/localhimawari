      var url3daysago = "https://veda01.cr.chiba-u.jp/views/cgi_1_1.py?ctype=2";
      url3daysago += "&lat=" + lat + "&lng=" + lng;
      url3daysago += "&year_1=" + year3daysago + "&month_1=" + month3daysago + "&day_1=" + date3daysago;
