      url += "&year_2=" + year + "&month_2=" + month + "&day_2=" + date;
      url += "&variable=dwn.sw.flx.sfc&type=msm";

      var day1weekago = new Date($.harpsModel.time.now);
      day1weekago.setDate(day1weekago.getDate() - 7);
      var year1weekago = day1weekago.getFullYear();
      var month1weekago = day1weekago.getMonth() + 1;
      var date1weekago = day1weekago.getDate();
