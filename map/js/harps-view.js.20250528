          });

          // 表示順変更処理
          var _toArray = function (ui) {
            var citem = $(ui.item[0]).attr("id");
            var items = $("#data_select_box > .data");
            var ilen = items.length;
            var sortArr = [];
            for (var i = 0; i < ilen; i++) {
              var $item = $("#data_select_box > .data").eq(i);
              if ($item.attr("id") === citem) {
                continue;
              }
              if ($item.hasClass("ui-sortable-placeholder")) {
                sortArr.push(citem);
                continue;
              }
              sortArr.push($item.attr("id"));
            }
            return sortArr;
          };
          $("#data_select_box").sortable({
            axis: "y",
            containment: "parent",
            tolerance: "pointer",
            distance: 10,
            items: ".data.sortable",
            handle: ".drag",
            update: function (e, ui) {
