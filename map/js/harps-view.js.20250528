            },
            change: function (e, ui) {
              var sortArr = _toArray(ui);
              $.harpsModel.overlayMaps.sort(sortArr);
            },
          });

          $(".ctrl_enabled dt.time").on({
            click: function () {
              var $dctrl = $(this).parents(".data");
              var dname = $dctrl.attr("id");
              var tileSetting = $.harpsModel.tiles.get(dname);
              if (tileSetting.cType != undefined) {
                for (var i = 0; i <= tileSetting.cType.max; i++) {
                  $(this).removeClass("ctype_" + i);
                }
                $.harpsModel.tiles.info[dname].cType++;
                if (
                  $.harpsModel.tiles.info[dname].cType > tileSetting.cType.max
                ) {
                  $.harpsModel.tiles.info[dname].cType =
                    tileSetting.cType.defval;
                }
                $.harpsModel.overlayMaps.update();
                $(this).addClass(
                  "ctype_" + $.harpsModel.tiles.info[dname].cType
                );
              }
            },
          });
          //*/
        },
        //*/
        slider: function () {
          var range_els = document.querySelectorAll("[class*=webkit] input[type=range]"),
                                  n_els, style_el, styles, units, base_sel, track_sel, _thumb_sel, a, b;

          if (range_els) {
            style_el = document.createElement("style");
            document.body.appendChild(style_el);

            n_els = range_els.length;

            styles = [];
            units = ["GHz", ["MB", "GB"], "GB"];

            base_sel = ".js input[type=range]";
            track_sel = ["::-webkit-slider-runnable-track", " /deep/ #track"];
            thumb_sel = ["::-webkit-slider-thumb", " /deep/ #thumb"];
            a = ":after";
            b = ":before";

            // スライダーの背景色の幅の変更処理
            var _chg_slider = function (slider) {
              var idx = slider.id.split("r")[1];
              min = slider.min || 0;
              max = slider.max || 10;
              perc = ~~((100 * (slider.value - min)) / (max - min));
              val = ~~slider.value;
              u = units[idx - 1];
              curr_sel = base_sel + "[id=r" + idx + "]";
              str = "";
              if (idx == 2) {
                u = u[val < 3 ? 0 : 1];
                val = val < 3 ? Math.pow(2, 7 + val) : val - 2;
              }

              str += curr_sel + track_sel[0] + "{background-size:" + perc + "% 100%}";
              str += curr_sel + thumb_sel[0] + b + "," + curr_sel + thumb_sel[1] + b + '{content:"' + val + '"}';
              str += curr_sel + thumb_sel[0] + a + "," + curr_sel + thumb_sel[1] + a + '{content:"' + u + '"}';

              styles[idx] = str;

              style_el.textContent = styles.join("");
            };

            for (var i = 0; i < n_els; i++) {
              $(range_els[i]).on({
                ch_opacity: function () {
                  _chg_slider(this);
                  if ($(this).attr("data-type") != undefined) {
                    var inputs = $(this).parents(".data").find("input[data-type=" + $(this).attr("data-type") + "]");
                    var ilen = inputs.length;
                    for (var j = 0; j < ilen; j++) {
                      var input = inputs[j];
                      if (input != this && input.value != this.value) {
                        input.value = this.value;
                        $.harpsModel.tiles.info[$(input).parents(".ctrl_enabled").attr("id")]["opacity"] = val;
                        _chg_slider(input);
                      }
                    }
                  }
                },
              });
              $(range_els[i]).trigger("ch_opacity");
            }
          }
        },
      },
      mobileTmpl: {
        create: function (tile, i) {
          /*
          var $ctrlBox = $(".mobile #data_select_box");
          var $ctrlUI = this.parentNode(tile, i);
          $ctrlBox.append($ctrlUI);
          */
        },
        parentNode: function (tile, i) {
          var slider = "";
          var sliderClass = "no-range";
          if (tile.transparent && tile.transparent == true) {
            $slider = $('<div id="range' + i + '" class="slider"><div class="slider-wrapper"><div class="opacity_slider" /></div></div>');
            $slider.attr("data-name", tile.name);
            $("#data_slider_box").append($slider);
          }
          var ctrlHtml = '<label class="data"><span /></label>';
          var $ctrl = $(ctrlHtml);
          $ctrl.attr("id", tile.name);
          $ctrl.children("span").text(tile.label);
          return $ctrl;
        },
        slider: function () {
          /*
