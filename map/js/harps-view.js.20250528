  var _initCtrl = function () {
    $("body").append('<div id="gps_button" class="btn gps_button"></div>');
    if (!$.harpsModel.util.isMobileWindow()) {
      $("#zoom_button").append('<div class="zoom_in btn"><span></span></div><div class="zoom_out btn"><span></span></div>');
      if ($.harpsEnv.menu_button) {
        if ($.harpsEnv.menu_button.playback && $.harpsEnv.menu_button.playback == true){
          $("body").append('<div id="playback_button" class="btn playback_button"></div>');
        }
        if ($.harpsEnv.menu_button.center && $.harpsEnv.menu_button.center == true){
          $("body").append('<div id="center_button" class="btn center_button"></div>');
        }
      }
    } else {
      $("#gps_button").addClass("mobile");
    }
    _initZoomBtn();
    _initDefaultBtn();
    _initGpsBtn();
    _initMenuBtn();
    _initSubMenu();
    _initDataControl();
  };

